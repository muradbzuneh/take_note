# ==========================================
# Notebook Application Environment Variables
# ==========================================

# Database Connection (Neon Serverless PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Better-Auth Configuration
# Run `openssl rand -base64 32` to generate a secure secret key
BETTER_AUTH_SECRET="your-32-byte-base64-secret-key-here"

# Application Base URL
# For local development: http://localhost:3000
# For production (Vercel): https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google OAuth Credentials (Optional: required for Google Sign-In)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email Configuration (Optional: required for email verification & password resets)
# Obtain from Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Notebook <onboarding@resend.dev>"
REQUIRE_EMAIL_VERIFICATION="false"
